includes:
	- extension.neon

parameters:
	level: 10
	bootstrapFiles:
		- vendor/squizlabs/php_codesniffer/autoload.php
	paths:
		- src
		- tests
	excludePaths:
		analyse:
			- tests/PHPCS/Fixtures/ClassesImplementingStringableMustImplementToStringNoncompliant.php
		analyseAndScan:
			- tests/PHPStan/Fixtures
