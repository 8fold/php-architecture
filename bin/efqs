#!/usr/bin/env php
<?php

declare(strict_types=1);

$files = [
    'docs:agents' => 'AGENTS.md',
    'docs:context' => 'docs/agent-context.md',
    'docs:graphify' => 'docs/graphify-workflow-setup.md',
];
if (!isset($argc, $argv) || $argc !== 2) {
    fwrite(STDERR, "Usage: efqs docs:agents|docs:context|docs:graphify\n");
    exit(1);
}

$command = $argv[1] ?? null;
if (!is_string($command) || !isset($files[$command])) {
    fwrite(STDERR, "Usage: efqs docs:agents|docs:context|docs:graphify\n");
    exit(1);
}

$projectRoot = getcwd();
if ($projectRoot === false) {
    fwrite(STDERR, "Unable to determine the current directory.\n");
    exit(1);
}

if (!is_file($projectRoot . DIRECTORY_SEPARATOR . 'composer.json')) {
    fwrite(STDERR, "Run this command from the consuming project root containing composer.json.\n");
    exit(1);
}

$relativePath = str_replace('/', DIRECTORY_SEPARATOR, $files[$command]);
$fileName = basename($relativePath);
$source = dirname(__DIR__) . DIRECTORY_SEPARATOR . $relativePath;
$content = @file_get_contents($source);
if ($content === false) {
    fwrite(STDERR, "Unable to read the package's {$fileName}: {$source}\n");
    exit(1);
}

$destination = $projectRoot . DIRECTORY_SEPARATOR . $relativePath;
$destinationDirectory = dirname($destination);
if (!is_dir($destinationDirectory) && !@mkdir($destinationDirectory, 0755, true)) {
    fwrite(STDERR, "Unable to create the destination directory: {$destinationDirectory}\n");
    exit(1);
}

if (file_exists($destination) || is_link($destination)) {
    if (!is_file($destination)) {
        fwrite(STDERR, "The destination exists and is not a regular file: {$destination}\n");
        exit(1);
    }

    $existing = @file_get_contents($destination);
    if ($existing === false) {
        fwrite(STDERR, "Unable to read the existing {$fileName}: {$destination}\n");
        exit(1);
    }

    if ($existing === $content) {
        fwrite(STDOUT, "{$fileName} is already current: {$destination}\n");
        exit(0);
    }

    fwrite(
        STDERR,
        "{$fileName} already exists and differs; refusing to overwrite: {$destination}\n"
    );
    exit(1);
}

$file = @fopen($destination, 'x');
if ($file === false) {
    fwrite(
        STDERR,
        "Unable to create {$fileName} without overwriting an existing file: {$destination}\n"
    );
    exit(1);
}

$length = strlen($content);
$offset = 0;
while ($offset < $length) {
    $written = @fwrite($file, substr($content, $offset));
    if ($written === false || $written === 0) {
        fclose($file);
        fwrite(
            STDERR,
            "Unable to write {$fileName}; the new file may be incomplete: {$destination}\n"
        );
        exit(1);
    }
    $offset += $written;
}

if (!fclose($file)) {
    fwrite(
        STDERR,
        "Unable to finish writing {$fileName}; the new file may be incomplete: {$destination}\n"
    );
    exit(1);
}

fwrite(STDOUT, "Copied {$fileName} to {$destination}\n");
