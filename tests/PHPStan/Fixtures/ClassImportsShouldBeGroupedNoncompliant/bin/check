#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Eightfold\Tests\PHPStan\Fixtures\ImportBin;

use Eightfold\Attributes\CallableSubtype;
use DateTimeImmutable;

/*
 * Extensionless PHP script with a shebang and no class declaration.
 * File discovery must include PHP entry points without requiring a .php suffix.
 * Expected: one eightfold.classImportsShouldBeGrouped diagnostic at the
 * CallableSubtype import; the PSL class DateTimeImmutable belongs first.
 * The shebang must not prevent import analysis or shift the reported location.
 */
$describe = static fn (DateTimeImmutable $date, CallableSubtype $subtype): string =>
    $date->format('c') . $subtype->value;

echo $describe(new DateTimeImmutable('2026-01-01'), CallableSubtype::cases()[0]);
